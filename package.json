{
  "name": "zxert",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "validate": "npm run typecheck && npm test",
    "prebuild": "expo prebuild"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "latest",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "latest",
    "expo": "~57.0.0",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-picker": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "lucide-react-native": "latest",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "latest",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "latest",
    "react-native-web": "~0.21.0",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@babel/core": "latest",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/react-native": "latest",
    "@types/jest": "latest",
    "@types/node": "^26.6.3",
    "@types/react": "latest",
    "eslint": "latest",
    "eslint-config-expo": "latest",
    "jest": "latest",
    "jest-expo": "~57.0.5",
    "prettier": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "latest"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/**/*.test.ts?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|nativewind|react-native-css-interop|tailwindcss|postcss|@tailwindcss))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
